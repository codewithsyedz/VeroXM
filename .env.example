# Used by docker-compose.yml only — variable substitution in that file, and
# the `db` service's credentials. Copy to `.env` in this same directory:
#   cp .env.example .env
# `.env` is already gitignored (see .gitignore's bare `.env` entry) — never
# commit real values here.

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=mycms
MYSQL_USER=mycms
MYSQL_PASSWORD=change-me-mycms-password

# --- Slice 1 (docs/IDENTITY-PLATFORM-RECOMMENDATION.md §7) ---
# Keycloak's own Postgres store (the `keycloak-db` service) — entirely
# separate from MYSQL_* above, on purpose.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password

# Bootstrap admin account for the local Keycloak admin console
# (http://localhost:8081) — local dev only, not a production credential.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

