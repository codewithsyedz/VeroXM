# Must match packages/db/.env.example / apps/web/.env.example exactly —
# all three processes talk to the same database.
DATABASE_URL="mysql://user:password@localhost:3306/mycms"

# Must match apps/web's API_JWT_SECRET exactly — this is what verifies the
# short-lived token apps/web mints after a successful NextAuth login.
API_JWT_SECRET="change-me-to-a-long-random-string"

# The Next.js dev server's origin, for CORS.
WEB_ORIGIN="http://localhost:3000"

PORT=4000

# --- Slice 1 (docs/IDENTITY-PLATFORM-RECOMMENDATION.md §7) ---
# Used only by KeycloakAuthGuard (apps/api/src/auth/keycloak-auth.guard.ts)
# to verify Keycloak-issued access tokens via JWKS — container-to-container,
# so this is the internal compose hostname, matching apps/web's
# KEYCLOAK_ISSUER_INTERNAL (never the host-published :8081 one). Leave unset
# and the one Slice 1 test route (GET /auth/keycloak-whoami) just 401s —
# nothing else in the app reads this.
KEYCLOAK_ISSUER_INTERNAL="http://keycloak:8080/realms/mycms-dev"

# Also accepted alongside the internal issuer above — see the
# comment in keycloak-auth.guard.ts for why both are valid.
KEYCLOAK_ISSUER_EXTERNAL="http://localhost:8081/realms/mycms-dev"

# --- Media storage (Phase 2) ---

# The legacy Laravel app's own public URL — used to build local-disk media
# URLs (/uploads/{uuid}/{file}), since the legacy app's existing route is
# still what serves those bytes for now; see docs/PHASE-2-NOTES.md.
APP_URL="https://cms.node2cloud.com"

# Where local-disk media actually lives on this machine. During the
# parallel-run, point this at the LEGACY repo's storage/app/public so both
# stacks share the same physical files — e.g. from apps/api:
# LOCAL_MEDIA_ROOT="../../../cms.node2cloud.com/storage/app/public"
LOCAL_MEDIA_ROOT="./media-storage"

MAX_FILE_SIZE_MB=20

# Only needed for projects whose `disk` column is 's3'.
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_URL_BASE=""

# --- Advanced use-cases plan (docs/ADVANCED-USE-CASES-IMPLEMENTATION-PLAN.md) ---

# Public API v1/v2 fixed-window rate limiter (apps/api/src/public-api/rate-limit.guard.ts).
# Defaults (120 requests / 60s) are used if left unset -- only set these to
# override for local testing.
# PUBLIC_API_RATE_LIMIT_MAX=120
# PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000

# §3.3 -- BullMQ/Redis background job queue (webhook delivery retries to
# start). Container-to-container hostname when run via `docker compose`
# (see docker-compose.yml's `redis` service, which overrides this exact
# var to redis://redis:6379) -- this localhost default is only for running
# apps/api directly on the host against a locally-installed Redis.
REDIS_URL="redis://localhost:6379"

# §4.1 -- read-path cache TTL (safety net alongside the event-driven
# invalidation listener; a cached read is never older than this even if an
# invalidation event were somehow missed). Default 60s if unset.
# READ_CACHE_TTL_SECONDS=60
